# ============================================================
# Core
# ============================================================
ENVIRONMENT=development
DEBUG=true

# ============================================================
# Database (PostgreSQL)
# ============================================================
DATABASE_URL=postgresql://trading:trading@db:5432/trading_bot

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# Security / Auth
# ============================================================
ENCRYPTION_KEY=change-me-to-a-32-byte-base64-key
SECRET_KEY=change-me-please-use-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
HASHING_ALGORITHM=bcrypt
BCRYPT_ROUNDS=12

# ============================================================
# Hermes AI (Local or OpenRouter)
# ============================================================
# Local Hermes Gateway (when running on same network)
# HERMES_API_BASE=http://hermes-gateway:8000/v1
# HERMES_API_KEY=sk-hermes-local
# OpenRouter fallback (free tier)
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it

# ============================================================
# Exchange API Keys (encrypted at rest; enter plain here for setup wizard)
# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=true
# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_SANDBOX=true
# KuCoin
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
KUCOIN_SANDBOX=true

# ============================================================
# Alerting
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# ============================================================
# Trading Defaults
# ============================================================
DEFAULT_TIMEFRAME=1h
DEFAULT_INITIAL_CAPITAL=10000
MAX_POSITION_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
DAILY_LOSS_LIMIT_PCT=5.0
